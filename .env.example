# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional WebRTC TURN Server configuration for Live Voice / Video / Broadcasts across strict NATs
# Public Google STUN servers are enabled by default in client WebRTC config.
VITE_TURN_URL=""
VITE_TURN_USERNAME=""
VITE_TURN_CREDENTIAL=""

# Supabase Storage (Server-side only — NEVER prefix with VITE_ or expose to frontend)
# SUPABASE_SERVICE_ROLE_KEY must be your Secret key (sb_secret_...) or Legacy service_role JWT (eyJ...), NOT sb_publishable_...
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_STORAGE_BUCKET="q-media"
